{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Taiyo.AI Unified Project Schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "original_id": {
      "type": "string",
      "description": "Unique identifier from the source",
      "minLength": 1
    },
    "aug_id": {
      "type": "string",
      "description": "Autogenerated UUID for Taiyo",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "country_name": {
      "type": "string",
      "enum": ["United States"],
      "description": "Country name; must be United States"
    },
    "country_code": {
      "type": "string",
      "enum": ["USA"],
      "description": "ISO 3166-3 country code"
    },
    "region_name": {
      "type": "string",
      "enum": ["North America"],
      "description": "World Bank region name"
    },
    "region_code": {
      "type": "string",
      "enum": ["NAC"],
      "description": "World Bank region code"
    },
    "title": {
      "type": "string",
      "description": "Project or tender title",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "Short summary of the project"
    },
    "status": {
      "type": "string",
      "enum": ["planned", "ongoing", "completed"],
      "description": "Current status of the project"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date the information was first published (YYYY-MM-DD)"
    },
    "procurementMethod": {
      "type": "string",
      "enum": ["open", "selective", "limited"],
      "description": "Procurement method"
    },
    "budget": {
      "type": ["number", "null"],
      "description": "Estimated value of the project"
    },
    "currency": {
      "type": ["string", "null"],
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 currency code"
    },
    "buyer": {
      "type": ["string", "null"],
      "description": "Entity funding the project"
    },
    "sector": {
      "type": ["string", "null"],
      "description": "High-level sector classification"
    },
    "subsector": {
      "type": ["string", "null"],
      "description": "Subsector classification"
    },
    "map_coordinates": {
      "type": ["object", "null"],
      "properties": {
        "type": { "type": "string", "enum": ["Point"] },
        "coordinates": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": ["type", "coordinates"],
      "description": "GeoJSON point [longitude, latitude]"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "URL of the source page"
    }
  },
  "required": [
    "original_id",
    "aug_id",
    "country_name",
    "country_code",
    "region_name",
    "region_code",
    "title",
    "status",
    "date",
    "url"
  ]
}